{
    "curl": {
        "apt": "curl"
    },
    "dos2unix": {
        "apt": "dos2unix"
    },
    "gh": {
        "archive": "tar.gz",
        "binpath": "gh_{VERSION}_{OS}_{ARCH}/bin/gh",
        "url": "https://github.com/cli/cli/releases/download/v{VERSION}/gh_{VERSION}_{OS}_{ARCH}.tar.gz",
        "version": "2.63.2"
    },
    "git": {
        "apt": "git"
    },
    "jq": {
        "apt": "jq"
    },
    "reviewdog": {
        "archive": "tar.gz",
        "binpath": "reviewdog",
        "url": "https://github.com/reviewdog/reviewdog/releases/latest/download/reviewdog_{OS}_{ARCH}.tar.gz"
    },
    "sha1sum": {
        "apt": "coreutils"
    },
    "shellcheck": {
        "archive": "tar.xz",
        "binpath": "shellcheck-v{VERSION}/shellcheck",
        "url": "https://github.com/koalaman/shellcheck/releases/download/v{VERSION}/shellcheck-v{VERSION}.{OS}.{ARCH}.tar.xz",
        "version": "0.10.0"
    },
    "yq": {
        "apt": "yq"
    }
}
